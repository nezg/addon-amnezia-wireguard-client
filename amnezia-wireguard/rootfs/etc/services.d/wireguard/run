#!/command/with-contenv bashio

declare interface

s6-svc -O /run/service/wireguard

bashio::log.info "Starting AmneziaWG client..."

export WG_I_PREFER_BUGGY_USERSPACE_TO_POLISHED_KMOD=1

interface=$(bashio::config "client.interface")

echo "--- AmneziaWG client configuration ---"
cat "/etc/amnezia/amneziawg/${interface}.conf"
echo "---------------------------------------"

exec awg-quick up "${interface}"